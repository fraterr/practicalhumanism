---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | The Curved Crater">
	<section>
		<h1>Contact</h1>
		<p>
			If you wish to reach out, transmit your message through the following channels:
		</p>
		
		<div class="contact-links">
			<p>
				<strong>Email:</strong> 
				<a href="mailto:hello@curvedcrater.com">hello@curvedcrater.com</a>
			</p>
			<p>
				<strong>GitHub:</strong> 
				<a href="https://github.com/curved-crater" target="_blank">github.com/curved-crater</a>
			</p>
		</div>
		
		<hr />
		
		<p>
			Expect a delayed response. Some signals take time to traverse the void.
		</p>
	</section>
</BaseLayout>
