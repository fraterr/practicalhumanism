---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout>
	<section class="intro reveal">
		<h1>Practical Humanism</h1>
		<p class="tagline">
			A digital laboratory dedicated to the intersection of electrons and consciousness.
		</p>
		<div class="quick-links">
			<a href={import.meta.env.BASE_URL + "/manifesto"} class="link-item">Manifesto</a>
			<span class="dot">•</span>
			<a href={import.meta.env.BASE_URL + "/tools"} class="link-item">Tools</a>
		</div>
	</section>

	<section class="latest-reflections">
		<div class="section-header reveal">
			<span class="subtitle">Latest Reflections</span>
			<hr class="mini-separator" />
		</div>

		<div class="posts-preview">
			{
				posts.map((post) => (
					<article class="home-post-card reveal">
						<span class="post-date">
							<FormattedDate date={post.data.pubDate} />
						</span>
						<a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`}>
							<h3>{post.data.title}</h3>
						</a>
						<p>{post.data.description}</p>
					</article>
				))
			}
		</div>

		<div class="view-all reveal">
			<a href={import.meta.env.BASE_URL + "/blog"} class="cta-button">
				Enter the Blog →
			</a>
		</div>
	</section>

	<script>
		const observerOptions = { threshold: 0.1 };
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('active');
				}
			});
		}, observerOptions);

		document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
	</script>
</BaseLayout>

<style>
	.intro {
		height: 50vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 0 2rem;
	}

	h1 {
		font-size: clamp(2.5rem, 8vw, 4rem);
		letter-spacing: 0.1em;
		margin-bottom: 1rem;
		font-weight: 300;
	}

	.tagline {
		font-size: 1.2rem;
		opacity: 0.8;
		max-width: 600px;
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.quick-links {
		display: flex;
		gap: 1.5rem;
		align-items: center;
		font-size: 1rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.link-item {
		color: var(--accent-color);
		text-decoration: none;
		transition: opacity 0.3s ease;
	}

	.link-item:hover {
		opacity: 0.7;
	}

	.dot {
		opacity: 0.3;
	}

	/* Latest Reflections Section */
	.latest-reflections {
		max-width: 900px;
		margin: 0 auto;
		padding: 4rem 2rem 8rem;
	}

	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.subtitle {
		font-size: 0.7rem;
		letter-spacing: 0.4em;
		text-transform: uppercase;
		opacity: 0.5;
		color: var(--accent-color);
	}

	.mini-separator {
		width: 30px;
		height: 1px;
		background: var(--accent-color);
		border: none;
		margin: 1rem auto 0;
		opacity: 0.3;
	}

	.posts-preview {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		margin-bottom: 4rem;
	}

	.home-post-card {
		border-left: 1px solid rgba(196, 139, 93, 0.1);
		padding-left: 2rem;
		transition: border-color 0.3s ease;
	}

	.home-post-card:hover {
		border-left-color: var(--accent-color);
	}

	.post-date {
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.5;
		display: block;
		margin-bottom: 0.8rem;
	}

	h3 {
		font-family: 'Playfair Display', serif;
		font-size: 1.8rem;
		margin-bottom: 0.8rem;
		transition: color 0.3s ease;
	}

	.home-post-card a {
		text-decoration: none;
		color: inherit;
	}

	.home-post-card a:hover h3 {
		color: var(--accent-color);
	}

	.home-post-card p {
		font-size: 1.05rem;
		line-height: 1.6;
		opacity: 0.7;
		max-width: 700px;
	}

	.view-all {
		text-align: center;
		margin-top: 2rem;
	}

	.cta-button {
		display: inline-block;
		padding: 1.2rem 2.5rem;
		border: 1px solid rgba(196, 139, 93, 0.3);
		color: var(--accent-color);
		text-decoration: none;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.9rem;
		transition: all 0.4s ease;
		background: rgba(196, 139, 93, 0.02);
	}

	.cta-button:hover {
		background: rgba(196, 139, 93, 0.1);
		border-color: var(--accent-color);
		transform: translateY(-2px);
	}

	/* Reveal Animation */
	.reveal {
		opacity: 0;
		transform: translateY(30px);
		transition: all 1.2s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}

	@media (max-width: 768px) {
		.intro {
			height: 70vh;
		}
		h1 {
			font-size: 3rem;
		}
		.latest-reflections {
			padding: 6rem 1.5rem;
		}
		.posts-preview {
			gap: 4rem;
		}
		h3 {
			font-size: 1.6rem;
		}
	}
</style>
