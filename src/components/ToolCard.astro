---
import { Image } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	icon: any;
	link: string;
	category: string;
}

const { title, description, icon, link, category } = Astro.props;
---

<div class="tool-card reveal">
	<div class="tool-icon">
		{typeof icon === 'string' ? (
			<img src={icon.startsWith('http') ? icon : (import.meta.env.BASE_URL + icon)} alt={title} width="64" height="64" />
		) : (
			<Image src={icon} alt={title} width={64} height={64} />
		)}
	</div>
	<div class="tool-info">
		<span class="category">{category}</span>
		<h3>{title}</h3>
		<p>{description}</p>
		<a href={link} class="tool-link" target="_blank" rel="noopener noreferrer">Open Tool →</a>
	</div>
</div>

<style>
	.tool-card {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(196, 139, 93, 0.1);
		padding: 3rem 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1.5rem;
		transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		position: relative;
		overflow: hidden;
	}

	.tool-card:hover {
		background: rgba(255, 255, 255, 0.05);
		border-color: rgba(196, 139, 93, 0.4);
		transform: translateY(-5px);
	}

	.tool-icon {
		opacity: 0.9;
		transition: transform 0.4s ease;
		margin-bottom: 1rem;
	}

	.tool-icon img {
		border-radius: 12px;
		object-fit: cover;
		border: 1px solid rgba(196, 139, 93, 0.1);
	}

	.tool-card:hover .tool-icon {
		transform: scale(1.05);
		opacity: 1;
	}

	.category {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		color: var(--accent-color);
		opacity: 0.6;
		display: block;
		margin-bottom: 0.5rem;
	}

	h3 {
		font-family: 'Playfair Display', serif;
		font-size: 1.7rem;
		margin: 0 0 0.75rem 0;
		color: var(--text-color);
	}

	p {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-color);
		opacity: 0.7;
		margin: 0 0 2rem 0;
		max-width: 260px;
	}

	.tool-link {
		display: inline-block;
		font-size: 0.85rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent-color);
		font-weight: 500;
		border-bottom: 1px solid transparent;
		padding-bottom: 4px;
	}

	.tool-link:hover {
		border-bottom-color: var(--accent-color);
	}

	/* Subtle background decoration */
	.tool-card::before {
		content: "";
		position: absolute;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background: radial-gradient(circle, rgba(196, 139, 93, 0.03) 0%, transparent 70%);
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}

	.tool-card:hover::before {
		opacity: 1;
	}
</style>
