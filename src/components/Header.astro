---
import HeaderLink from './HeaderLink.astro';
import SkullLogo from './SkullLogo.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="logo">
			<a href={import.meta.env.BASE_URL}>
				<SkullLogo size={48} />
				<span>{SITE_TITLE}</span>
			</a>
		</div>

		<button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu">
			<span class="line"></span>
			<span class="line"></span>
		</button>

		<div class="links" id="nav-menu">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/manifesto">Manifesto</HeaderLink>
			<HeaderLink href="/tools">Tools</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<a href="https://www.buymeacoffee.com/practicalhumanism" class="bmc-custom-button" target="_blank" rel="noopener noreferrer">
				<span class="emoji">🍵</span>
				<span>Buy me a tea</span>
			</a>
		</div>
	</nav>
</header>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const navMenu = document.getElementById('nav-menu');

	menuToggle?.addEventListener('click', () => {
		menuToggle.classList.toggle('active');
		navMenu?.classList.toggle('open');
	});
</script>

<style>
	nav {
		max-width: 960px;
		position: relative;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.logo a {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: var(--text-color);
		font-family: 'Playfair Display', serif;
		font-size: 1.6rem;
		white-space: nowrap;
	}
	.logo a:hover {
		border: none;
	}
	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 8px;
		width: 32px;
		height: 32px;
		background: transparent;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 100;
	}
	.menu-toggle .line {
		width: 100%;
		height: 1px;
		background-color: var(--text-color);
		transition: all 0.3s ease;
	}
	.menu-toggle.active .line:nth-child(1) {
		transform: translateY(4.5px) rotate(45deg);
	}
	.menu-toggle.active .line:nth-child(2) {
		transform: translateY(-4.5px) rotate(-45deg);
	}
	.bmc-custom-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--line-color);
		border-radius: 4px;
		color: var(--text-color);
		font-family: 'Playfair Display', serif;
		font-size: 1rem;
		text-decoration: none;
		transition: all 0.3s ease;
		background: rgba(196, 139, 93, 0.05);
		white-space: nowrap;
	}
	.bmc-custom-button:hover {
		background: rgba(196, 139, 93, 0.15);
		border-color: var(--accent-color);
		color: var(--accent-color);
		transform: translateY(-1px);
	}
	.bmc-custom-button .emoji {
		font-size: 1.1rem;
	}
	@media (max-width: 768px) {
		.logo a {
			font-size: 1.4rem;
			gap: 0.8rem;
		}
		.menu-toggle {
			display: flex;
		}
		.links {
			display: none;
			position: absolute;
			top: calc(100% + 2rem);
			left: -2rem;
			right: -2rem;
			background-color: var(--bg-color);
			flex-direction: column;
			padding: 2rem;
			gap: 1.5rem;
			border-bottom: 1px solid var(--line-color);
			z-index: 99;
			box-shadow: 0 10px 20px rgba(0,0,0,0.5);
		}
		.links.open {
			display: flex;
			animation: fadeIn 0.3s ease;
		}
		.bmc-custom-button {
			width: 100%;
			justify-content: center;
			margin-top: 0.5rem;
			padding: 0.6rem;
		}
	}
	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>
