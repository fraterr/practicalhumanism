---
import HeaderLink from './HeaderLink.astro';
import SkullLogo from './SkullLogo.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="logo">
			<a href={import.meta.env.BASE_URL}>
				<SkullLogo size={48} />
				<span>{SITE_TITLE}</span>
			</a>
		</div>
		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/manifesto">Manifesto</HeaderLink>
			<HeaderLink href="/tools">Tools</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<a href="https://www.buymeacoffee.com/practicalhumanism" class="bmc-custom-button" target="_blank" rel="noopener noreferrer">
				<span class="emoji">🍵</span>
				<span>Buy me a tea</span>
			</a>
		</div>
	</nav>
</header>

<style>
	nav {
		max-width: 960px;
	}
	.links {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.logo a {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: var(--text-color);
		font-family: 'Playfair Display', serif;
		font-size: 1.6rem;
		white-space: nowrap;
	}
	.logo a:hover {
		border: none;
	}
	.bmc-custom-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.3rem 0.8rem;
		border: 1px solid var(--line-color);
		border-radius: 4px;
		color: var(--text-color);
		font-family: 'Playfair Display', serif;
		font-size: 1rem;
		text-decoration: none;
		transition: all 0.3s ease;
		background: rgba(196, 139, 93, 0.05);
		white-space: nowrap;
	}
	.bmc-custom-button:hover {
		background: rgba(196, 139, 93, 0.15);
		border-color: var(--accent-color);
		color: var(--accent-color);
		transform: translateY(-1px);
	}
	.bmc-custom-button .emoji {
		font-size: 1.1rem;
	}
	@media (max-width: 768px) {
		.logo a {
			font-size: 1.4rem;
			gap: 0.8rem;
		}
		.links {
			flex-direction: column;
			gap: 0.8rem;
			width: 100%;
		}
		.bmc-custom-button {
			width: 100%;
			justify-content: center;
			margin-top: 0.5rem;
			padding: 0.6rem;
		}
	}
</style>
