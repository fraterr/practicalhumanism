---
import HeaderLink from './HeaderLink.astro';
import SkullLogo from './SkullLogo.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="logo">
			<a href={import.meta.env.BASE_URL}>
				<SkullLogo size={48} />
				<span>{SITE_TITLE}</span>
			</a>
		</div>
		<div class="links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/manifesto">Manifesto</HeaderLink>
			<HeaderLink href="/tools">Tools</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
			<script is:inline type="text/javascript" src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js" data-name="bmc-button" data-slug="practicalhumanism" data-color="#d28732" data-emoji="🍵"  data-font="Inter" data-text="Buy me a tea" data-outline-color="#000000" data-font-color="#000000" data-coffee-color="#FFDD00" ></script>
		</div>
	</nav>
</header>

<style>
	.logo a {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: var(--text-color);
		font-family: 'Playfair Display', serif;
		font-size: 1.6rem;
	}
	.logo a:hover {
		border: none;
	}
	@media (max-width: 768px) {
		.logo a {
			font-size: 1.4rem;
			gap: 0.8rem;
		}
	}
</style>
