---
const { size = 48 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Skull in 3/4 Perspective -->
  
  <!-- Main Cranium -->
  <path d="M45 15 
           C 25 15, 12 30, 15 55 
           C 16 70, 25 80, 32 85
           L 32 92 Q 32 95, 38 95
           L 55 95 Q 60 95, 60 92
           L 62 82
           C 75 75, 88 60, 85 40
           C 82 15, 65 15, 45 15 Z" 
        stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
  
  <!-- Left Eye Socket (more visible) -->
  <path d="M25 50 Q 35 45, 42 52 Q 40 65, 30 65 Q 22 62, 25 50 Z" 
        fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="1.5" />
  
  <!-- Right Eye Socket (narrower due to perspective) -->
  <path d="M60 48 Q 68 45, 75 50 Q 73 60, 65 62 Q 58 58, 60 48 Z" 
        fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="1.5" />
  
  <!-- Nasal Cavity -->
  <path d="M48 68 L 45 78 L 52 75 Z" fill="currentColor" />
  
  <!-- Cheekbone definition -->
  <path d="M15 55 C 15 65, 25 75, 32 80" stroke="currentColor" stroke-width="1" opacity="0.6" />
  <path d="M85 40 C 85 55, 75 70, 62 82" stroke="currentColor" stroke-width="1" opacity="0.6" />
  
  <!-- Jaw / Teeth (3/4 perspective) -->
  <path d="M35 88 L 35 94" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  <path d="M42 88 L 42 94" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  <path d="M49 88 L 49 94" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
  <path d="M56 88 L 56 94" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />

  <!-- Hebrew Letter Shin (ש) on Forehead (skewed for perspective) -->
  <g transform="translate(42, 25) rotate(-5) scale(0.65, 0.6)">
    <path d="M0 0 L 2 18 Q 3 20, 5 20 L 20 20 Q 22 20, 23 18 L 25 0" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" />
    <path d="M11 0 L 12 18" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" />
  </g>
</svg>

<style>
  svg {
    display: inline-block;
    vertical-align: middle;
    color: var(--accent-color);
    filter: drop-shadow(0 0 2px rgba(196, 139, 93, 0.15));
  }
</style>
