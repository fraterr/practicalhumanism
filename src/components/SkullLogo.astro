---
const { size = 48 } = Astro.props;
---

<img src={import.meta.env.BASE_URL + "/skull-logo.png"} alt="Skull with Shin" width={size} height={size} class="skull-logo" />

<style>
  .skull-logo {
    display: inline-block;
    vertical-align: middle;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
