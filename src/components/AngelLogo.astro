---
const { size = 40 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- The Sun -->
  <circle cx="50" cy="40" r="25" stroke="currentColor" stroke-width="1.5" />
  
  <!-- Rays -->
  <line x1="50" y1="5" x2="50" y2="12" stroke="currentColor" stroke-width="1" />
  <line x1="50" y1="68" x2="50" y2="75" stroke="currentColor" stroke-width="1" />
  <line x1="15" y1="40" x2="22" y2="40" stroke="currentColor" stroke-width="1" />
  <line x1="78" y1="40" x2="85" y2="40" stroke="currentColor" stroke-width="1" />
  
  <line x1="25" y1="15" x2="30" y2="20" stroke="currentColor" stroke-width="1" />
  <line x1="75" y1="15" x2="70" y2="20" stroke="currentColor" stroke-width="1" />
  <line x1="25" y1="65" x2="30" y2="60" stroke="currentColor" stroke-width="1" />
  <line x1="75" y1="65" x2="70" y2="60" stroke="currentColor" stroke-width="1" />

  <!-- Angel Silhouette (Wings) -->
  <path d="M50 50 C 30 45, 10 60, 15 80" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  <path d="M50 50 C 70 45, 90 60, 85 80" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
  
  <!-- Angel Body -->
  <path d="M50 45 L 50 85" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <circle cx="50" cy="45" r="4" fill="currentColor" />
</svg>

<style>
  svg {
    display: inline-block;
    vertical-align: middle;
    color: var(--accent-color);
  }
</style>
